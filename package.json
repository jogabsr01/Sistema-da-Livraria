{
  "name": "livraria-ipb-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/check-google-dev.mjs && node scripts/build-public.mjs",
    "schema:generate": "node scripts/generate-gas-schema.mjs",
    "test": "node --test tests/backend/*.test.mjs",
    "test:browser": "python3 scripts/test-public-build.py",
    "test:passkeys": "python3 scripts/test-passkeys.py",
    "test:access": "python3 scripts/test-owner-access.py",
    "test:catalog": "python3 scripts/test-catalog.py",
    "test:checkout": "python3 scripts/test-checkout.py",
    "test:operations": "python3 scripts/test-operations.py",
    "test:customers": "python3 scripts/test-customers.py",
    "test:staff": "python3 scripts/test-staff.py",
    "test:stock": "python3 scripts/test-stock.py",
    "test:notifications": "python3 scripts/test-notifications.py",
    "test:photos": "python3 scripts/test-cover-photos.py",
    "test:diagnostics": "python3 scripts/test-prototype-diagnostics.py",
    "test:isbn": "python3 scripts/test-shared-isbn.py",
    "test:cover-hardening": "python3 scripts/test-cover-hardening.py",
    "test:photo-isbn": "python3 scripts/test-photo-isbn.py"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "sharp": "0.35.5"
  }
}
