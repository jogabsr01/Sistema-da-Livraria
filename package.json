{
  "name": "livraria-ipb-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/check-google-dev.mjs && node scripts/build-public.mjs",
    "schema:generate": "node scripts/generate-gas-schema.mjs",
    "test": "node --test tests/backend/*.test.mjs",
    "test:browser": "python3 scripts/test-public-build.py",
    "test:passkeys": "python3 scripts/test-passkeys.py",
    "test:access": "python3 scripts/test-owner-access.py",
    "test:catalog": "python3 scripts/test-catalog.py"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3"
  }
}
