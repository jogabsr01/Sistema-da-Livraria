/* Administrative niche metadata, private backgrounds and durable projections.
 * Uses existing Nichos/Configuracoes, no schema migration. Dispatcher holds lock. */
function nicheFail_(code){failure_(code||'INVALID_NICHE');}
function nicheText_(v,max,multi){if(typeof v!=='string')nicheFail_();v=v.normalize('NFC').replace(/\r\n?/g,'\n').trim();if(v.length>max||(multi?/[\x00-\x09\x0b-\x1f\x7f]/:/[\x00-\x1f\x7f]/).test(v)||/^[=+@-]/.test(v))nicheFail_();return v;}
function nicheRecord_(r){authControlExact_(r,['name','description','color','order','active']);if(!nicheText_(r.name,100)||r.name!==nicheText_(r.name,100)||r.description!==nicheText_(r.description,1000,true)||!/^#[a-f0-9]{6}$/.test(r.color)||!Number.isSafeInteger(r.order)||r.order<0||r.order>9999||typeof r.active!=='boolean')nicheFail_();return r;}
function nicheRevision_(ss,id){var row=staffConfig_(ss,'niche.revision.'+id).row;if(!row)return 0;if(!Number.isSafeInteger(row.Valor)||row.Valor<1)nicheFail_('NICHES_UNAVAILABLE');return row.Valor;}
function nicheDtos_(ss,rows){var counts=new Map(),versions=new Map();catalogLinks_(ss).rows.forEach(function(l){if(l.ID_Nicho)counts.set(l.ID_Nicho,(counts.get(l.ID_Nicho)||0)+1);});identityRows_(ss,'Configuracoes').rows.filter(function(r){return r.Chave.indexOf('niche.revision.')===0;}).forEach(function(r){var id=r.Chave.slice('niche.revision.'.length);if(!identityUuid_(id)||versions.has(id)||!Number.isSafeInteger(r.Valor)||r.Valor<1)nicheFail_('NICHES_UNAVAILABLE');versions.set(id,r.Valor);});return rows.map(function(r){return {id:r.ID_Nicho,name:r.Nome,description:r.Descricao,color:r.Cor_Destaque,order:r.Ordem_Exibicao,active:r.Ativo,version:versions.get(r.ID_Nicho)||0,hasImage:!!r.Imagem_Drive_ID,productCount:counts.get(r.ID_Nicho)||0};});}
function nicheImage_(c,id,nicheId,expected,unmarked){
 var folder=coverFolder_(c),file=resourceFile_(id),parents=file.getParents(),ok=false;while(parents.hasNext())if(parents.next().getId()===folder.getId())ok=true;
 if(!ok||file.getSharingAccess()!==DriveApp.Access.PRIVATE||file.getMimeType()!=='image/jpeg'||file.getSize()>49152)failure_('BINDING_MISMATCH');
 var bytes=file.getBlob().getBytes(),hash=coverBytesHash_(bytes),m;try{m=JSON.parse(file.getDescription());}catch(_){m=null;}
 if(!m&&!unmarked)failure_('BINDING_MISMATCH');if(m){assertMarker_(file,c,'niche-image');if(m.nicheId!==nicheId||!identityUuid_(m.commandId)||!constantEqual_(m.sha256,hash))failure_('BINDING_MISMATCH');}if(expected&&expected!==hash)nicheFail_('NICHE_CONFLICT');
 var photo={bytes:Utilities.base64Encode(bytes),sha256:hash};coverDescriptor_(photo);return {file:file,marker:m,photo:photo};
}
function nicheEnsureImage_(c,id,commandId,photo){var bytes=coverDescriptor_(photo),folder=coverFolder_(c),names=folder.getFilesByName('niche-'+id+'-'+commandId+'.jpg'),files=[];while(names.hasNext()){files.push(names.next());if(files.length>1)nicheFail_('NICHES_UNAVAILABLE');}var file=files.length?files[0]:folder.createFile(Utilities.newBlob(bytes,'image/jpeg','niche-'+id+'-'+commandId+'.jpg')),checked=nicheImage_(c,file.getId(),id,photo.sha256,true);if(checked.marker&&checked.marker.commandId!==commandId)failure_('BINDING_MISMATCH');if(!checked.marker){var m=JSON.parse(marker_(c,'niche-image'));m.nicheId=id;m.commandId=commandId;m.sha256=photo.sha256;file.setDescription(JSON.stringify(m));}nicheImage_(c,file.getId(),id,photo.sha256,false);return file.getId();}
function nicheCommands_(ss){return identityRows_(ss,'Configuracoes').rows.filter(function(r){return r.Chave.indexOf('niche.command.')===0;}).map(function(r){var v;try{v=JSON.parse(r.Valor);}catch(_){nicheFail_('NICHES_UNAVAILABLE');}if(!v||v.version!==1||r.Chave!=='niche.command.'+v.id||!identityUuid_(v.id)||!identityUuid_(v.nicheId)||!identityUuid_(v.actor)||!['ADMIN','SUPER_ADMIN'].includes(v.role)||!['PENDING','COMPLETE'].includes(v.state)||!accessHash_(v.fingerprint)||!Number.isSafeInteger(v.revision)||v.revision<1||v.before!==null&&!Array.isArray(v.before)||!Array.isArray(v.after))nicheFail_('NICHES_UNAVAILABLE');authControlTime_(v.at);var copy=JSON.parse(JSON.stringify(v));delete copy.hash;delete copy.state;if(!constantEqual_(v.hash,digest_(JSON.stringify(copy))))nicheFail_('NICHES_UNAVAILABLE');return v;});}
function nicheProject_(ss,v){var table=identityRows_(ss,'Nichos'),cols=table.columns,found=table.rows.filter(function(r){return r.ID_Nicho===v.nicheId;});if(found.length>1||v.after.length!==cols.length||v.after[cols.indexOf('ID_Nicho')]!==v.nicheId||v.before!==null&&(v.before.length!==cols.length||v.before[cols.indexOf('ID_Nicho')]!==v.nicheId))nicheFail_('NICHES_UNAVAILABLE');var values=found.length?cols.map(function(k){return found[0][k];}):null;if(!same_(values,v.before)&&!same_(values,v.after))nicheFail_('NICHE_CONFLICT');var revision=nicheRevision_(ss,v.nicheId);if(![v.revision-1,v.revision].includes(revision))nicheFail_('NICHE_CONFLICT');if(!same_(values,v.after)){var row={number:found.length?found[0].number:undefined};cols.forEach(function(k,i){row[k]=v.after[i];});accessSaveMain_(table,row);}staffPut_(ss,'niche.revision.'+v.nicheId,v.revision,v.at,v.actor);
 var summary=function(x,rev){return {revision:rev,name:x?x[cols.indexOf('Nome')]:null,color:x?x[cols.indexOf('Cor_Destaque')]:null,order:x?x[cols.indexOf('Ordem_Exibicao')]:null,active:x?x[cols.indexOf('Ativo')]:null};};
 var audit=identityRows_(ss,'Logs_Auditoria'),logged=audit.rows.filter(function(r){return r.ID_Log===v.id;}),log={ID_Log:v.id,Data_Hora:v.at,ID_Usuario:v.actor,Perfil:v.role,Acao:v.before?'NICHE_UPDATE':'NICHE_CREATE',Entidade:'Nichos',ID_Entidade:v.nicheId,Antes:JSON.stringify(summary(v.before,v.revision-1)),Depois:JSON.stringify(Object.assign(summary(v.after,v.revision),{imageChanged:v.imageChanged,descriptionChanged:!v.before||v.before[cols.indexOf('Descricao')]!==v.after[cols.indexOf('Descricao')]})),Resultado:'SUCESSO',ID_Requisicao:v.id};if(logged.length>1||logged.length&&!audit.columns.every(function(k){return logged[0][k]===log[k];}))nicheFail_('NICHES_UNAVAILABLE');if(!logged.length)accessSaveMain_(audit,log);v.state='COMPLETE';staffPut_(ss,'niche.command.'+v.id,JSON.stringify(v),v.at,v.actor);
}
function recoverNiches_(c){var ss=storage_(c,false).spreadsheet,pending=nicheCommands_(ss).filter(function(v){return v.state==='PENDING';});if(pending.length>1)nicheFail_('NICHES_UNAVAILABLE');pending.forEach(function(v){nicheProject_(ss,v);});}
function nichesOperation_(request,c){
 if(!request.actor||!accessHash_(request.actor.sessionTokenHash))failure_('UNAUTHENTICATED');var ss=storage_(c,false).spreadsheet,principal=identitySession_(ss,request.actor.sessionTokenHash,Date.now()).principal,p=request.payload,table=catalogNiches_(ss);recoverCatalog_(c);recoverSales_(ss);
 if(request.action==='niches.image'){authControlExact_(p,['id']);if(!identityUuid_(p.id))nicheFail_();var row=table.rows.filter(function(r){return r.ID_Nicho===p.id;})[0];if(!row||!row.Imagem_Drive_ID||!row.Ativo&&!['ADMIN','SUPER_ADMIN'].includes(principal.role))nicheFail_('NICHE_NOT_FOUND');return nicheImage_(c,row.Imagem_Drive_ID,p.id,null,false).photo;}
 staffAdmin_(principal);if(request.action==='niches.list'){authControlExact_(p,[]);return {niches:nicheDtos_(ss,table.rows)};}
 if(request.action!=='niches.save')failure_('FORBIDDEN');var has=Object.prototype.hasOwnProperty.call(p,'image');authControlExact_(p,['commandId','id','expectedRevision','record','fingerprint'].concat(has?['image']:[]));if(!identityUuid_(p.commandId)||!identityUuid_(p.id)||!Number.isSafeInteger(p.expectedRevision)||p.expectedRevision<0||p.expectedRevision>1000000||!accessHash_(p.fingerprint))nicheFail_();nicheRecord_(p.record);
 var commands=nicheCommands_(ss),prior=commands.filter(function(v){return v.id===p.commandId;});if(prior.length){if(prior[0].actor!==principal.id||prior[0].nicheId!==p.id||prior[0].fingerprint!==p.fingerprint)nicheFail_('NICHE_CONFLICT');return {id:p.id,version:prior[0].revision};}
 var found=table.rows.filter(function(r){return r.ID_Nicho===p.id;}),old=found[0];if(nicheRevision_(ss,p.id)!==p.expectedRevision||!old&&p.expectedRevision!==0)nicheFail_('NICHE_CONFLICT');
 var normalized=function(s){return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\s+/g,' ').trim();};if(table.rows.some(function(r){return r.ID_Nicho!==p.id&&normalized(r.Nome)===normalized(p.record.name);}))nicheFail_('NICHE_DUPLICATE');
 if(!old&&table.rows.length>=200||commands.length>=1000||identityRows_(ss,'Configuracoes').rows.length+2>5000||identityRows_(ss,'Logs_Auditoria').rows.length>=5000)nicheFail_('NICHES_UNAVAILABLE');if(identityRows_(ss,'Logs_Auditoria').rows.some(function(r){return r.ID_Log===p.commandId;}))nicheFail_('NICHE_CONFLICT');
 var at=new Date().toISOString(),row=old?JSON.parse(JSON.stringify(old)):{ID_Nicho:p.id,Criado_Por:principal.id,Criado_Em:at,Imagem_Drive_ID:''};row.Nome=p.record.name;row.Descricao=p.record.description;row.Cor_Destaque=p.record.color;row.Ordem_Exibicao=p.record.order;row.Ativo=p.record.active;if(has)row.Imagem_Drive_ID=p.image===null?'':nicheEnsureImage_(c,p.id,p.commandId,p.image);
 var v={version:1,id:p.commandId,nicheId:p.id,actor:principal.id,role:principal.role,state:'PENDING',fingerprint:p.fingerprint,revision:p.expectedRevision+1,at:at,before:old?table.columns.map(function(k){return old[k];}):null,after:table.columns.map(function(k){return row[k];}),imageChanged:has};var copy=JSON.parse(JSON.stringify(v));delete copy.state;v.hash=digest_(JSON.stringify(copy));staffPut_(ss,'niche.command.'+v.id,JSON.stringify(v),at,principal.id);nicheProject_(ss,v);return {id:p.id,version:v.revision};
}
