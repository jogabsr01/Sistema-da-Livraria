# Local documentation only. Configure real values privately in Netlify Functions scope.
# Never commit a filled .env. Netlify supplies CONTEXT, BRANCH and DEPLOY_PRIME_URL.
WORKSPACE_BACKEND_ENABLED=false
APP_ENV=dev
WORKSPACE_INSTALLATION_ID=
WORKSPACE_SCRIPT_URL=
WORKSPACE_SPREADSHEET_ID=
WORKSPACE_DRIVE_ROOT_ID=
WORKSPACE_HMAC_SECRET=
# Even with all values configured, identity remains closed until Phase C.

# Optional DEV-only build handshake; never enables the operational backend.
WORKSPACE_VERIFY_CONNECTION=false

# Do not enable until verified onboarding, MFA and persistent throttling are ready.
WORKSPACE_IDENTITY_SESSIONS_ENABLED=false
WORKSPACE_SESSION_TOKEN_KEY=

# Server-only controls. Keep flags off until the controlled DEV acceptance.
WORKSPACE_IDENTITY_GUARDS_ENABLED=false
WORKSPACE_AUTH_GUARD_KEY=

# Owner first access/login is implemented, but real activation remains closed.
WORKSPACE_IDENTITY_PASSKEYS_ENABLED=false
WORKSPACE_IDENTITY_ACCESS_ENABLED=false
WORKSPACE_PIN_PEPPER=

# Shared product catalog, only after verified DEV sessions and Google provisioning.
WORKSPACE_CATALOG_ENABLED=false

# Optional authenticated bibliographic lookup; keep off until controlled DEV acceptance.
WORKSPACE_ISBN_LOOKUP_ENABLED=false

# Private cover photos; enabled only after controlled DEV acceptance.
WORKSPACE_COVER_PHOTOS_ENABLED=false
